<MudDrawer Open="@SideBarOpen" Fixed="true" Elevation="1" Variant="@DrawerVariant.Mini" Color="Color.Secondary" ClipMode="DrawerClipMode.Always">

    <MudNavMenu>
        <AuthorizeView>
            <Authorized>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.ManageAccounts" @bind-Expanded="_isExpanded">
                    <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.Settings">Dashboard</MudNavLink>
                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.Person">Users</MudNavLink>
                    <MudNavLink Href="/admin/plants" Icon="@Icons.Material.Filled.Nature">Plants</MudNavLink>
                    <MudNavLink Href="/admin/groups" Icon="@Icons.Material.Filled.GroupWork">Groups</MudNavLink>
                    <MudNavLink Href="/admin/variables" Icon="@Icons.Material.Filled.Science">Variables</MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</MudDrawer>

@code 
{
    [Parameter]
    public bool SideBarOpen { get; set; }
    private bool _isExpanded = true;
}
