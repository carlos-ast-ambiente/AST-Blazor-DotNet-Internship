@page "/admin/variables"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BlazorApp.Models
@using BlazorApp.Services
@attribute [Authorize(Roles = "Admin")]
@inject VariableService VariableService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">

    <BlazorApp.Components.Pages.AdminHeader />

    <MudPaper Elevation="6" Class="pa-8">
        
        @if (_loading) {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else {
            <MudDataGrid T="Variable" Items="@variables" Hover="true" RowClick="OnRowClick" QuickFilter="FilterVariables">
                <ToolBarContent>
                    <MudText Typo="Typo.h4" Class="mb-4">Variables</MudText>
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mb-4 mr-16 ml-8"></MudTextField>
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Class="rounded-pill" OnClick="@CreateVariable">Create new variable</MudButton>
                    </MudButtonGroup>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Enabled" Title="">
                        <CellTemplate>
                            <MudPaper Elevation="0" Width="4px" Height="40px" Class="ma-0 d.block" Style="@($"background-color: {(context.Item.Enabled ? "green" : "red")};")" />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Name" />
                    <PropertyColumn Property="x => x.Description" />
                    <TemplateColumn Title="Group" HeaderClass="large-header">
                        <CellTemplate>
                            @if (!context.Item.Enabled) {
                                <i>-------</i>
                            } else if (context.Item.Group is null) {
                                <i>No group</i>
                            } else {
                                @context.Item.Group.Name
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Plants" HeaderClass="large-header">
                        <CellTemplate>
                            @if (!context.Item.Enabled) {
                                <i>-------</i>
                            } else if (context.Item.Plants.Any()) {
                                @string.Join(",", context.Item.Plants.Where(p => p.Enabled).Select(p => p.Name))
                            } else {
                                <i>No plants</i>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Edit">
                        <CellTemplate>
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => NavigateToEdit(context.Item))" />
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(async () => await ConfirmDeleteAsync(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<Variable> variables = new();
    private bool _loading = true;

    private Variable? variable;
    private string _searchString;

    protected override async Task OnInitializedAsync() {
        await ReloadVariablesAsync();
    }

    private Func<Variable, bool> FilterVariables => variable =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return variable.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || variable.Description.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };

    private async Task ReloadVariablesAsync() {
        _loading = true;

        variables = await VariableService.GetVariablesAsync();

        _loading = false;
    }

    private void NavigateToEdit(Variable variable) {
        NavigationManager.NavigateTo($"/admin/variables/{variable.Id}/editVariables");
    }

    private void NavigateToVariable(Variable variable) {
        NavigationManager.NavigateTo($"/admin/variables/{variable.Id}");
    }

    private void CreateVariable() {
        NavigationManager.NavigateTo("/admin/variables/createVariable");
    }

    private async Task ConfirmDeleteAsync(Variable variable) {
        if (variable is null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete {variable.Name}?");
        if (!confirmed) return;

        try {
            await VariableService.Delete(variable.Id);
        
            await ReloadVariablesAsync();
        }
        catch (Exception ex) {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting group: {ex.Message}");
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<Variable> variable) {
        NavigateToVariable(variable.Item);
    }
}
