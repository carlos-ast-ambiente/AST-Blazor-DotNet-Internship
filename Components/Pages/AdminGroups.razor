@page "/admin/groups"
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Models
@using BlazorApp.Services
@attribute [Authorize(Roles = "Admin")]
@inject GroupService GroupService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">

    <BlazorApp.Components.Pages.AdminHeader />
    
    <MudText Typo="Typo.h4">Groups</MudText>
    <MudGrid Class="mt-4">
        @foreach (var group in groups) {
            <MudItem xs="12" sm="6" md="4">
                <div @onclick="() => NavigateToGroup(group.Id)" style="cursor: pointer; display: block; height: 100%;">
                    <MudCard Elevation="4" Class="hover-card" Style="height: 100%; position: relative;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Secondary"><b>@group.Name</b></MudText>
                                <MudText Typo="Typo.body2">Number of variables: @group.Variables.Count</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Color="@(group.Enabled ? Color.Success : Color.Error)" Size="Size.Small">
                                    @(group.Enabled ? "Enabled" : "Disabled")
                                </MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">Click to view details</MudText>

                            <div class="d-flex flex-nowrap justify-end gap-1 mt-auto ms-auto mb-3 me-3" style="width: 90%; max-width: 100%; overflow-x: auto; overflow-y: auto; white-space: nowrap; ms-overflow-style: none; scrollbar-width: none;">
                                @foreach (var variable in group.Variables)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Href="@($"/admin/variables")">
                                        @variable.Name
                                    </MudChip>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudItem>
        }
        <AuthorizeView Roles="Admin">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="4" Class="hover-card" Style="height: 100%;" @onclick='() => NavigationManager.NavigateTo("/admin/plants/createGroup")'>
                    <MudCardContent Class="d-flex flex-column align-center justify-center" Style="min-height: 140px;">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
                        <MudText Typo="Typo.h6">Add a new group</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </AuthorizeView>
    </MudGrid>
</MudContainer>


@code {
    private List<Group> groups = new();
    private int count = 0;
    
    protected override async Task OnInitializedAsync() {
        groups = await GroupService.GetAllGroups();
    }

    private void NavigateToGroup(int id) {
        NavigationManager.NavigateTo($"/admin/groups/{id}");
    }
}
